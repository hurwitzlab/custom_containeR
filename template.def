Bootstrap: docker
From: @BASE_REF@

# ------------------------------------------------------------
# GENERATED by custom_containeR/generate_def.sh. Do not hand-edit the
# generated copy; change the image's config.sh / packages.txt and regenerate.
#
# Reproducibility pins:
#   base image  : @BASE_IMAGE_REPO@:@R_VERSION@ pinned by digest (tags get rebuilt)
#   CRAN        : Posit Package Manager snapshot @SNAPSHOT_DATE@
#   Bioconductor: release @BIOC_VERSION@, PPM snapshot @SNAPSHOT_DATE@
#   GitHub      : commit SHAs (enforced by generate_def.sh)
#   apt (sysreqs installed by pak): not pinned, logged to dpkg_packages.tsv
#
# %post is deliberately NOT indented: heredoc terminators must start at
# column 0.
# ------------------------------------------------------------

%labels
    Maintainer @MAINTAINER@
    Name @NAME@
    VersionTag @VERSION_TAG@
    R_Version @R_VERSION@
    Base_Image @BASE_IMAGE_REPO@:@R_VERSION@
    Base_Digest @BASE_DIGEST@
    Snapshot_Date @SNAPSHOT_DATE@
    Bioc_Version @BIOC_VERSION@
    Generated @GENERATED@

%help
    @NAME@ (@VERSION_TAG@): R @R_VERSION@ with a pinned package set.

    Usage:
        apptainer exec @NAME@_@VERSION_TAG@.sif Rscript my_script.R
        apptainer run  @NAME@_@VERSION_TAG@.sif          # interactive R

    What's inside (requested packages, versions, sources):
        apptainer exec @NAME@_@VERSION_TAG@.sif @CMD@ --help
        apptainer exec @NAME@_@VERSION_TAG@.sif @CMD@ --all

    Provenance (exact versions of everything installed):
        apptainer exec @NAME@_@VERSION_TAG@.sif ls /opt/provenance
        apptainer exec @NAME@_@VERSION_TAG@.sif cat /opt/provenance/renv.lock

    The library is read-only. Host libraries under ~/R are deliberately
    excluded from .libPaths().

%post -c /bin/bash
# The header MUST be '%post -c /bin/bash'. Apptainer ignores shebangs in
# %post, and the default /bin/sh (dash) rejects 'set -o pipefail'. Without
# set -e a failed step still produces a "successful" but broken image.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Hazel bind-mount points
mkdir -p /rs1 /share /home /usr/local/usrapps
mkdir -p /opt/provenance

# Apptainer bind-mounts the build host's /tmp and /var/tmp into %post.
# build.sh binds a per-job scratch dir over them, but this .def may also be
# built by hand without that bind, so keep all scratch files (R tempdir(),
# pak downloads and build trees, callr files) inside the image rootfs too.
# pak's workers otherwise leave ~150 MB behind per build.
# NEVER `rm` anything under /tmp here: it may be the host's real /tmp.
export TMPDIR=/opt/build-tmp
mkdir -p "$TMPDIR"

# --- Pin package repositories to the snapshot -------------------------------
# Binary URLs are per Ubuntu release, so read the codename from the base
# image rather than hardcoding it.
. /etc/os-release
SNAPSHOT_DATE="@SNAPSHOT_DATE@"
CRAN_URL="https://p3m.dev/cran/__linux__/${VERSION_CODENAME}/${SNAPSHOT_DATE}"
BIOC_MIRROR="https://p3m.dev/bioconductor/__linux__/${VERSION_CODENAME}/${SNAPSHOT_DATE}"

# Appended so it overrides the CRAN repo rocker sets earlier in the file.
# Applies at build time and at runtime.
cat >> "$(R RHOME)/etc/Rprofile.site" <<EOF

## --- custom_containeR: pinned repositories (snapshot ${SNAPSHOT_DATE}) ---
options(repos = c(CRAN = "${CRAN_URL}"), BioC_mirror = "${BIOC_MIRROR}")
## Keep only container libraries on the path. /home is bind-mounted on
## Hazel, so a host ~/R library would otherwise mix in host-built packages.
.libPaths(Filter(function(p) startsWith(p, "/usr/local/lib/R"), .libPaths()))
EOF

export R_BIOC_VERSION="@BIOC_VERSION@"   # read by pak/pkgcache
export PKG_SYSREQS=true                  # pak installs required apt libraries

# --- Install ----------------------------------------------------------------
# pak and renv themselves come from the same snapshot.
Rscript -e 'install.packages(c("pak", "renv"))'

cat > /opt/provenance/requested_packages.txt <<'EOF'
@PACKAGES@
EOF

cat > /opt/provenance/install.R <<'EOF'
prov <- "/opt/provenance"
refs <- readLines(file.path(prov, "requested_packages.txt"))
refs <- refs[nzchar(trimws(refs))]

res <- pak::pkg_install(refs, ask = FALSE, upgrade = FALSE)

# R package names of the directly requested refs (they can differ from
# GitHub repo names); %test loads each of these.
direct <- sort(unique(res$package[res$direct]))
writeLines(direct, file.path(prov, "direct_packages.txt"))

# Lockfile covering every non-base package in the image.
lockproj <- file.path(tempdir(), "lockproj")
dir.create(lockproj)
options(renv.bioconductor.version = Sys.getenv("R_BIOC_VERSION"))
renv::snapshot(project = lockproj, library = .libPaths(),
               lockfile = file.path(prov, "renv.lock"),
               type = "all", prompt = FALSE, force = TRUE)

# Flat table of everything installed, including where it came from.
fields <- c("Repository", "RemoteType", "RemoteUsername", "RemoteRepo",
            "RemoteRef", "RemoteSha", "Built")
ip <- installed.packages(fields = fields)
cols <- c("Package", "Version", "Priority", "LibPath", fields)
write.table(ip[order(ip[, "Package"]), cols],
            file.path(prov, "installed_packages.tsv"),
            sep = "\t", quote = FALSE, row.names = FALSE, na = "")

# What `@CMD@ --help` shows: each package once (the copy that loads first
# on .libPaths()), where it came from, and whether it was requested.
ip <- installed.packages(fields = c(fields, "git_url"))
ip <- ip[!duplicated(ip[, "Package"]), , drop = FALSE]
src <- ifelse(ip[, "RemoteType"] %in% "github",
              paste0("GitHub ", ip[, "RemoteUsername"], "/", ip[, "RemoteRepo"], "@", ip[, "RemoteSha"]),
       ifelse(grepl("bioconductor", ip[, "git_url"]), "Bioconductor",
       ifelse(ip[, "Priority"] %in% "base", "R (base)",
       ifelse(ip[, "Priority"] %in% "recommended" & ip[, "LibPath"] == .Library,
              "R (recommended)", "CRAN"))))
pv <- data.frame(Package = ip[, "Package"], Version = ip[, "Version"], Source = src,
                 Requested = ifelse(ip[, "Package"] %in% direct, "yes", ""))
write.table(pv[order(tolower(pv$Package)), ], file.path(prov, "package_versions.tsv"),
            sep = "\t", quote = FALSE, row.names = FALSE)

# sessionInfo with every requested package attached.
for (p in direct) suppressPackageStartupMessages(library(p, character.only = TRUE))
writeLines(c(capture.output(sessionInfo()), "",
             "repos:", paste0("  ", names(getOption("repos")), " = ", getOption("repos")),
             paste0("BioC_mirror = ", getOption("BioC_mirror")),
             paste0("R_BIOC_VERSION = ", Sys.getenv("R_BIOC_VERSION"))),
           file.path(prov, "sessionInfo.txt"))
EOF

Rscript /opt/provenance/install.R

dpkg-query -W -f='${Package}\t${Version}\n' > /opt/provenance/dpkg_packages.tsv

cat > /opt/provenance/build_info.txt <<EOF
name           @NAME@
version_tag    @VERSION_TAG@
r_version      @R_VERSION@
base_image     @BASE_IMAGE_REPO@:@R_VERSION@
base_digest    @BASE_DIGEST@
os             ${PRETTY_NAME}
snapshot_date  ${SNAPSHOT_DATE}
cran_repo      ${CRAN_URL}
bioc_version   @BIOC_VERSION@
bioc_mirror    ${BIOC_MIRROR}
maintainer     @MAINTAINER@
generated      @GENERATED@
built          $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

# --- `@CMD@ --help`: say what is in the image -------------------------------
# deploy.sh exposes this as a module command next to R and Rscript.
if command -v @CMD@ >/dev/null; then
    echo "ERROR: '@CMD@' is already a command in the image ($(command -v @CMD@)); use another NAME" >&2
    exit 1
fi
cat > /usr/local/bin/@CMD@ <<'EOF'
#!/bin/bash
# Describe this image: requested packages and versions, and where the full
# build records are. Written by custom_containeR's template.def; reads only
# /opt/provenance, so it shows exactly what this image was built with.
set -euo pipefail
P=/opt/provenance
CMD=$(basename "$0")
IMG="${APPTAINER_CONTAINER:-${SINGULARITY_CONTAINER:-<image>.sif}}"
info() { awk -v k="$1" '$1 == k {sub(/^[^ ]+ +/, ""); print; exit}' "$P/build_info.txt"; }

# Table of package_versions.tsv rows; $1 = "yes" for requested only, "" for all.
table() {
    awk -F'\t' -v want="$1" '
        NR > 1 && (want == "" || $4 == want) {
            n++; p[n] = $1; v[n] = $2; s[n] = $3
            if (length($1) > w1) w1 = length($1)
            if (length($2) > w2) w2 = length($2)
        }
        END {
            fmt = "  %-" w1 "s  %-" w2 "s  %s\n"
            printf fmt, "Package", "Version", "Source"
            for (i = 1; i <= n; i++) printf fmt, p[i], v[i], s[i]
        }' w1=7 w2=7 "$P/package_versions.tsv"
}
count() { awk -F'\t' -v want="$1" 'NR > 1 && (want == "" || $4 == want)' "$P/package_versions.tsv" | wc -l; }

case "${1:---help}" in
-h|--help)
    cat <<END
$(info name) $(info version_tag)
  R $(info r_version), Bioconductor $(info bioc_version)
  CRAN and Bioconductor packages from the Posit Package Manager snapshot of $(info snapshot_date)
  Base image: $(info base_image) ($(info base_digest))
  Built $(info built), maintainer $(info maintainer)

Requested packages ($(count yes) of $(count "") R packages installed; the rest are dependencies or come with R):
$(table yes)

Run R:
  Rscript my_script.R                           (with the module loaded)
  apptainer exec $IMG Rscript my_script.R

More:
  $CMD --all        every R package in the image, with version and source
  $CMD --system     system (apt) packages
  $CMD --lockfile   renv.lock (recreate this library with renv::restore())
  Build records: /opt/provenance inside the image
END
    ;;
--all)      table "" ;;
--system)   printf 'Package\tVersion\n'; cat "$P/dpkg_packages.tsv" ;;
--lockfile) cat "$P/renv.lock" ;;
--version)  echo "$(info name) $(info version_tag) (R $(info r_version), Bioconductor $(info bioc_version), snapshot $(info snapshot_date))" ;;
*)          echo "usage: $CMD [--help | --all | --system | --lockfile | --version]" >&2; exit 1 ;;
esac
EOF
chmod 755 /usr/local/bin/@CMD@

# --- Clean up ---------------------------------------------------------------
# NEVER touch /tmp here (host /tmp, see top of %post).
apt-get clean
rm -rf /var/lib/apt/lists/* /root/.cache/R "$TMPDIR"

%environment
    # Keep host R settings out. Apptainer passes the host environment through
    # (e.g. R_LIBS_SITE from a loaded R module) and `unset` here does NOT
    # remove host values, but `export` does override them. So pin each
    # variable to the container's own value. Covers `R --vanilla` too, which
    # skips the Rprofile.site filter.
    export R_HOME=/usr/local/lib/R
    export R_LIBS=/usr/local/lib/R/site-library:/usr/local/lib/R/library
    export R_LIBS_SITE=/usr/local/lib/R/site-library
    export R_LIBS_USER=/nonexistent/custom_containeR

%runscript
    exec R "$@"

%test
    set -e
    # Simulate a host R module leaking library paths in.
    export R_LIBS=/host/leak R_LIBS_SITE=/host/leak R_LIBS_USER=/host/leak
    . /.singularity.d/env/90-environment.sh
    Rscript -e '
      lp <- .libPaths()
      stopifnot("host library on .libPaths()" = all(startsWith(lp, "/usr/local/lib/R")))
      pk <- readLines("/opt/provenance/direct_packages.txt")
      for (p in pk) suppressPackageStartupMessages(library(p, character.only = TRUE))
      cat("OK:", length(pk), "requested packages load; libPaths:", lp, "\n")
    '
    # The info command runs and lists every requested package as requested.
    @CMD@ --help > /dev/null
    @CMD@ --all > /dev/null
    [ "$(awk -F'\t' '$4 == "yes"' /opt/provenance/package_versions.tsv | wc -l)" \
      -eq "$(wc -l < /opt/provenance/direct_packages.txt)" ]
    echo "OK: @CMD@ --help"
